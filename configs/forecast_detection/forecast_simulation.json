{
  "simulation": {
    "n_samples": 1000,
    "method": "monte_carlo",
    "correlation_model": "none",
    "correlation_strength": 0.0,
    "seed": 42
  },
  "methods_to_run": [
    "weighted_score",
    "threshold",
    "bin_threshold",
    "logistic_weighted"
  ],
  "filters": {
    "ability_variants": ["base", "lower", "upper"],
    "cost_variants": ["base"],
    "min_samples": 10,
    "max_samples": null,
    "sampler_types": ["uniform"]
  },
  "threshold_estimator": {
    "engine": "scikit-learn",
    "max_iter": 100,
    "C": 1.0,
    "tol": 0.001,
    "solver": "lbfgs",
    "warm_start": false
  },
  "weighted_score": {
    "range_min": -5,
    "range_max": 20,
    "normalize": false,
    "n_bins": 10,
    "use_original_window": false,
    "truncate_bins": false,
    "weight_function": {
      "type": "linear",
      "base": 0.0,
      "slope": 1.0
    }
  },
  "output": {
    "save_individual_simulations": true,
    "save_convergence_stats": true
  },
  "risk_thresholds": {
  "threshold": [10,20,30],
  "weighted_score": [10,20,30,40,50,60]
  }
}
