{
  "simulation": {
    "n_samples": 1000,
    "method": "monte_carlo",
    "correlation_model": "none",
    "correlation_strength": 0.0,
    "seed": 42
  },
  "methods_to_run": ["threshold", "weighted_score"],
  "filters": {
    "ability_variants": ["base", "lower", "upper"],
    "cost_variants": ["base"],
    "min_samples": 10,
    "max_samples": null,
    "sampler_types": ["uniform"]
  },
  "threshold_estimator": {
    "engine": "scikit-learn",
    "max_iter": 100,
    "C": 1.0,
    "tol": 0.001,
    "solver": "lbfgs",
    "warm_start": false
  },
  "weighted_score": {
    "range_min": -5,
    "range_max": 20,
    "normalize": true,
    "weight_function": {
      "type": "linear",
      "base": 1.0,
      "slope": 0.5
    }
  },
  "output": {
    "save_individual_simulations": false,
    "save_convergence_stats": true
  }
}
